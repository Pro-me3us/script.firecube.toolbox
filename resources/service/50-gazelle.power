#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later

LED=/storage/.kodi/addons/service.firecube_lightbar
USB_POWER_STATE=/run/gazelle-usb-power-off

usb_boot()
{
  flash_dev=$(awk '$2=="/flash"{print $1}' /proc/mounts)
  case "$flash_dev" in
    /dev/sd*) return 0 ;;
    *) return 1 ;;
  esac
}

unmount_usb_storage()
{
  # Flush pending writes
  sync

  # Unmount filesystems backed by USB storage devices
  for mountpoint in $(awk '$1 ~ "^/dev/sd[a-z][0-9]*$" {print $2}' /proc/mounts); do
    [ -n "$mountpoint" ] || continue

    echo "<6>gazelle-power: Unmounting USB storage $mountpoint" > /dev/kmsg

    if ! umount "$mountpoint"; then
      echo "<3>gazelle-power: Failed to unmount USB storage $mountpoint" > /dev/kmsg
      return 1
    fi
  done

  return 0
}

set_gpio()
{
  offset="$1"
  value="$2"
  name="$3"

  for chip in /sys/class/gpio/gpiochip*; do
    [ "$(cat "$chip/label" 2>/dev/null)" = periphs-banks ] && [ "$(cat "$chip/ngpio" 2>/dev/null)" = 157 ] || continue

    gpio=$(($(cat "$chip/base") + offset))

    echo "$gpio" > /sys/class/gpio/export &&
      echo "$value" > /sys/class/gpio/gpio${gpio}/direction
    echo "$gpio" > /sys/class/gpio/unexport

    echo "<6>gazelle-power: Set $name $value (gpio=$gpio)" > /dev/kmsg
    break
  done
}

case "$1" in
  pre)
    kodi-send --action="NotifyAll(lightbar,off)"
    sleep .2
    python "$LED/led.py" -n1 -b100 -f "$LED/resources/animations/active-end.animation"
    sleep 1

    ethtool -s eth0 wol d
    ip link set eth0 down
    rfkill block bluetooth
    
    # Remove any stale state
    rm -f "$USB_POWER_STATE"

    # Only handle USB storage if CoreELEC is not booting from USB
    if ! usb_boot; then

      # Only disable USB power if all USB storage can be unmounted
      if unmount_usb_storage; then

        # Disable USB power
        set_gpio 36 low "GPIOX_16"

        # Remember that this script disabled USB power
        touch "$USB_POWER_STATE"

        echo "<6>gazelle-power: USB power disabled" > /dev/kmsg
      else
        echo "<3>gazelle-power: USB storage still mounted, leaving USB power on" > /dev/kmsg
      fi
    fi
    ;;

  post)
    systemd-run --no-block python "$LED/led.py" -n1 -b100 -f "$LED/resources/animations/active-thinking.animation"

    # Re-enable HDMI v5 GPIO
    set_gpio 38 high "GPIOX_18"
    echo "<6>gazelle-power: HDMI v5 restored" > /dev/kmsg

    # Only restore USB power if script disabled it during pre
    if [ -f "$USB_POWER_STATE" ]; then
      set_gpio 36 high "GPIOX_16"

      rm -f "$USB_POWER_STATE"

      echo "<6>gazelle-power: USB power restored" > /dev/kmsg
    fi
    
    rfkill unblock bluetooth
    ip link set eth0 up
    ethtool -s eth0 wol g
    systemd-run --no-block kodi-send --action="NotifyAll(lightbar,on)"
    ;;
esac
